{
  "name": "magic-flowers",
  "version": "1.0.0",
  "description": "Čarovná záhrada – multiplayerová hra o pestovaní kvetov (mobil, vertikálne)",
  "main": "src/server/server.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/server/server.ts",
    "dev": "npm run build && DAY_SECONDS=60 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/server/server.ts",
    "test": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON node --test 'test/*.test.js' 'test/*.test.ts'",
    "typecheck": "tsc",
    "lint": "eslint --no-error-on-unmatched-pattern ."
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
